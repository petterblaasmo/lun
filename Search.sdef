<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Lun Terminology">
    <!-- In Safari's words and codes: a script can ask for the address and
         title of the tabs, and the names of a window's space and profile,
         and say which of a window's tabs is in front, and nothing else.
         Private tabs are not listed.
         count is here because "repeat with t in tabs" asks for it; set,
         because "set current tab of window 1 to tab 2 of window 1" does. -->
    <suite name="Lun Suite" code="Srch" description="Windows and their tabs, to read, and the tab in front to choose.">
        <command name="set" code="coresetd" description="Set an object's data.">
            <cocoa class="NSSetCommand"/>
            <direct-parameter type="specifier" description="The object to set."/>
            <parameter name="to" code="data" type="any" description="The new value.">
                <cocoa key="Value"/>
            </parameter>
        </command>
        <command name="count" code="corecnte" description="Return the number of elements of a particular class within an object.">
            <cocoa class="NSCountCommand"/>
            <direct-parameter type="specifier" description="The objects to be counted."/>
            <parameter name="each" code="kocl" type="type" optional="yes" hidden="yes" description="The class of objects to be counted.">
                <cocoa key="ObjectClass"/>
            </parameter>
            <result type="integer" description="The count."/>
        </command>
        <class name="application" code="capp" description="Lun.">
            <cocoa class="NSApplication"/>
            <element type="window" access="r">
                <cocoa key="orderedWindows"/>
            </element>
        </class>
        <class name="window" code="cwin" description="A browser window.">
            <cocoa class="NSWindow"/>
            <!-- A tab is known as "tab N of window id …": without the id, a
                 tab a script kept hold of couldn't be found again. -->
            <property name="id" code="ID  " type="integer" access="r" description="The unique identifier of the window.">
                <cocoa key="uniqueID"/>
            </property>
            <element type="tab" access="r">
                <cocoa key="scriptTabs"/>
            </element>
            <property name="current tab" code="cTab" type="tab" access="rw" description="The tab showing in the window; missing value when it is a private tab. Set it to one of the window's tabs to go to that tab.">
                <cocoa key="scriptCurrentTab"/>
            </property>
            <!-- Safari has no word for these, so the codes are Search's own:
                 Apple keeps the all-lowercase ones. -->
            <property name="space" code="wSpc" type="text" access="r" description="The name of the space the window shows; missing value when its tab in front is private.">
                <cocoa key="scriptSpace"/>
            </property>
            <property name="profile" code="wPrf" type="text" access="r" description="The name of the profile the window is in; missing value when its tab in front is private.">
                <cocoa key="scriptProfile"/>
            </property>
        </class>
        <class name="tab" plural="tabs" code="bTab" description="A tab. Private tabs are never listed.">
            <cocoa class="ScriptTab"/>
            <property name="URL" code="pURL" type="text" access="r" description="The address of the page on screen in the tab.">
                <cocoa key="url"/>
            </property>
            <property name="name" code="pnam" type="text" access="r" description="The title of the tab's page.">
                <cocoa key="name"/>
            </property>
        </class>
    </suite>
</dictionary>
